<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/content_main2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:background="#2E5370"
        android:orientation="vertical"
        android:scaleX="1">

        <!-- LinearLayout جدید برای نمایش اوقات شرعی -->
        <LinearLayout
            android:id="@+id/prayer_times_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="45"
            android:elevation="0dp"
            android:orientation="vertical"
            android:background="#f0f0f0"
            android:gravity="center"
            android:padding="16dp"
            >
            <TextView
                android:id="@+id/text_next_prayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="نماز بعدی: "
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/text_time_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColor="#009688"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/text_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="در حال دریافت موقعیت..."
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_weight="55"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:elevation="0dp"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_namaz"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:elevation="0dp"
                    app:cardBackgroundColor="#00000000"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/imageView7"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:elevation="6dp"
                        android:scaleType="fitXY"
                        app:srcCompat="@drawable/a22"/>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="9dp"
                    android:text="نماز"
                    android:textColor="#000000"
                    android:textSize="16sp"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_vuzu"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:elevation="0dp"
                    app:cardBackgroundColor="#00000000"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/imageView9"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:elevation="6dp"
                        android:scaleType="fitXY"
                        app:srcCompat="@drawable/a11"/>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="9dp"
                    android:text="@string/vuzu_title"
                    android:textColor="#000000"
                    android:textSize="16sp"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_adhan_times"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:elevation="0dp"
                    app:cardBackgroundColor="#00000000"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/adhan_times"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:elevation="6dp"
                        android:scaleType="fitXY"
                        app:srcCompat="@drawable/adhan_times"/>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text="@string/adhan_times"
                    android:textColor="#000000"
                    android:textSize="16sp"/>


            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:elevation="0dp"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_ghosl"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#00000000"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/imageView8"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:elevation="6dp"
                        android:scaleType="fitXY"
                        app:srcCompat="@drawable/a44"/>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="9dp"
                    android:text="@string/ghosl_title"
                    android:textColor="#000000"
                    android:textSize="16sp"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_tayammom"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:elevation="0dp"
                    app:cardBackgroundColor="#00000000"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/imageView2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:elevation="6dp"
                        android:scaleType="fitXY"
                        app:srcCompat="@drawable/a66"/>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="9dp"
                    android:text="@string/tayammom_title"
                    android:textColor="#000000"
                    android:textSize="16sp"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_compass"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:elevation="0dp"
                    app:cardBackgroundColor="#00000000"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/imageView_compass"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:elevation="6dp"
                        android:scaleType="fitXY"
                        app:srcCompat="@drawable/dial2"/>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="9dp"
                    android:text="@string/compass_title"
                    android:textColor="#000000"
                    android:textSize="16sp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:elevation="0dp"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_tasbihat"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:elevation="0dp"
                    app:cardBackgroundColor="#00000000"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/imageView3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:elevation="6dp"
                        android:scaleType="fitXY"
                        app:srcCompat="@drawable/a55"/>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="9dp"
                    android:text="@string/tasbihat_title"
                    android:textColor="#000000"
                    android:textSize="14sp"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_sejdeyesahv"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:elevation="0dp"
                    app:cardBackgroundColor="#00000000"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/imageView6"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:elevation="6dp"
                        android:scaleType="fitXY"
                        app:srcCompat="@drawable/a33"/>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text="سجده سهو"
                    android:textColor="#000000"
                    android:textSize="16sp"/>

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
