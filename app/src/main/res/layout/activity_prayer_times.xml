<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F6F7F9"
    tools:context=".PrayerTimesActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header / Current location -->
        <TextView
            android:id="@+id/text_current_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مکان فعلی: در حال بارگذاری..."
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#263238"
            android:layout_marginBottom="12dp" />

        <!-- Location Mode Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardUseCompatPadding="true"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="انتخاب مکان"
                    android:textColor="#37474F"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp"
                    android:layout_gravity="right"/>

                <RadioGroup
                    android:id="@+id/radio_group_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_horizontal"
                    android:layout_marginBottom="10dp">

                    <RadioButton
                        android:id="@+id/radio_gps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="GPS"
                        android:textColor="#263238"
                        android:layout_marginEnd="18dp"
                        android:buttonTint="@color/radio_tint"
                        />

                    <RadioButton
                        android:id="@+id/radio_manual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="دستی"
                        android:textColor="#263238"
                        android:buttonTint="@color/radio_tint"
                        />
                </RadioGroup>

                <!-- Manual location area (hidden by default) -->
                <LinearLayout
                    android:id="@+id/layout_manual_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="کشور"
                        android:textColor="#607D8B"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/spinner_country"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_spinner_selector"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:spinnerMode="dropdown"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="استان"
                        android:textColor="#607D8B"
                        android:textSize="12sp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/spinner_province"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_spinner_selector"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:spinnerMode="dropdown"
                        />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="شهر"
                        android:textColor="#607D8B"
                        android:textSize="12sp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/spinner_city"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_spinner_selector"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:spinnerMode="dropdown"
                        />

                    <Button
                        android:id="@+id/btn_set_manual_location"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="تنظیم مکان دستی"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#00897B"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- GPS button (visible by default; in Java hide it when manual is selected) -->
                <Button
                    android:id="@+id/btn_get_location"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="گرفتن مکان"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#00897B" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Next Prayer (Hero Card) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:cardUseCompatPadding="true"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="نماز بعدی"
                    android:textColor="#607D8B"
                    android:textSize="13sp"
                    android:layout_gravity="right"/>

                <TextView
                    android:id="@+id/text_next_prayer_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="نماز بعدی: --:--"
                    android:textColor="#263238"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/text_remaining_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="زمان باقی‌مانده: --:--"
                    android:textColor="#607D8B"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Prayer Times Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="true"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="اوقات شرعی"
                    android:textColor="#37474F"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp"
                    android:layout_gravity="right"/>

                <TextView
                    android:id="@+id/text_fajr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="صبح: --:--"
                    android:textColor="#263238"
                    android:textSize="18sp"
                    android:paddingVertical="6dp" />

                <TextView
                    android:id="@+id/text_sunrise"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="طلوع: --:--"
                    android:textColor="#263238"
                    android:textSize="18sp"
                    android:paddingVertical="6dp" />

                <TextView
                    android:id="@+id/text_dhuhr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ظهر: --:--"
                    android:textColor="#263238"
                    android:textSize="18sp"
                    android:paddingVertical="6dp" />

                <TextView
                    android:id="@+id/text_asr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="عصر: --:--"
                    android:textColor="#263238"
                    android:textSize="18sp"
                    android:paddingVertical="6dp" />

                <TextView
                    android:id="@+id/text_maghrib"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="مغرب: --:--"
                    android:textColor="#263238"
                    android:textSize="18sp"
                    android:paddingVertical="6dp" />

                <TextView
                    android:id="@+id/text_isha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="عشاء: --:--"
                    android:textColor="#263238"
                    android:textSize="18sp"
                    android:paddingVertical="6dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Settings Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="true"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تنظیمات اذان"
                    android:textColor="#37474F"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp"
                    android:layout_gravity="right"/>

                <Switch
                    android:id="@+id/switch_auto_adhan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="پخش شدن صدای اذان"
                    android:textColor="#263238"
                    android:layout_marginBottom="6dp" />

                <Switch
                    android:id="@+id/switch_play_adhan_sound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="فقط نمایش وقت اذان (نوتیفیکیشن)"
                    android:textColor="#263238"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="شیوه محاسبه اوقات شرعی "
                    android:textColor="#37474F"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp"
                    android:layout_gravity="right"/>
                <Spinner
                    android:id="@+id/spinner_calculation_method"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_spinner_selector"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:spinnerMode="dropdown"
                    />

                <Button
                    android:id="@+id/btn_play_adhan"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="پخش دستی اذان"
                    android:textColor="#00897B"
                    android:backgroundTint="#E0F2F1" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp" />
    </LinearLayout>
</ScrollView>
