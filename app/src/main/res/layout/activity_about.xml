<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_about"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.androidhive.myapplication.source_activities.AboutActivity">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/w"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:elevation="1dp"
            android:layout_height="0dp"
            android:layout_weight=".4"
            android:layout_marginTop="15dp">

            <ImageView
                android:layout_width="match_parent"
                app:srcCompat="@drawable/ssss"
                android:id="@+id/imageView4"
                android:layout_weight="1"
                android:layout_height="match_parent"/>
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight=".35"
            android:gravity="center">

            <TextView
                android:text="لطفا برای بهبود برنامه نظرات و انتقادات خود را با ما در میان بگذارید."
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/textView13"
                android:textColor="@color/cardview_dark_background"
                android:gravity="center_horizontal"
                android:textSize="22sp"
                android:layout_weight=".5"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:paddingTop="10dp"/>

            <TextView
                android:text="با ما در ارتباط باشید"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:id="@+id/textView10"
                android:textColor="@color/cardview_dark_background"
                android:gravity="center_horizontal"
                android:textSize="24sp"
                android:layout_marginTop="20dp"
                android:layout_weight=".5"/>

        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight=".1"
            android:layout_marginTop="20dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/download"
                android:id="@+id/email"
                android:layout_weight="1"/>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/telegram"
                android:id="@+id/telegram"
                android:layout_weight="1"/>

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight=".10">
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
