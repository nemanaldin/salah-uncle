<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_vuzu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.androidhive.myapplication.source_activities.VuzuActivity"
    android:background="@drawable/square">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <Button
            android:text="@string/meyet_title"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:id="@+id/btnmeyyet"
            android:height="50dp"
            android:background="#03bbd3"
            android:textSize="24sp"
            android:textColor="@color/cardview_light_background"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:id="@+id/button2"
            android:height="4dp"
            android:background="#81d4fa"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="8dp"
                android:layout_marginTop="7dp"
                app:cardBackgroundColor="@color/cardview_light_background">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:paddingTop="5dp">

                    <TextView
                        android:id="@+id/txt_meyyet"
                        style="@style/txtViewDetails"
                        android:layout_width="match_parent"

                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="@string/meyyet"
                        android:textColor="#FF141919"
                        android:textSize="18sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txt_meyyet1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="3dp"
                            android:layout_marginTop="3dp"
                            android:layout_marginRight="5dp"
                            android:layout_weight=".8"
                            android:padding="5dp"
                            android:text="@string/meyyet1"
                            android:textColor="#000000"
                            android:textSize="18sp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight=".2"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/imgmeyyet"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                app:srcCompat="@drawable/play_button"/>
                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txt_meyyet2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:textColor="#FF141919"
                        android:textSize="18sp"
                        android:text="@string/meyyet2"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txt_meyyet3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="3dp"
                            android:layout_marginTop="3dp"
                            android:layout_marginRight="5dp"
                            android:layout_weight=".8"
                            android:padding="5dp"
                            android:text="@string/meyyet3"
                            android:textColor="#000000"
                            android:textSize="18sp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight=".2"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/imgmeyyet1"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                app:srcCompat="@drawable/play_button"/>
                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txt_meyyet4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:textColor="#FF141919"
                        android:textSize="18sp"
                        android:text="@string/meyyet4"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txt_meyyet5"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="3dp"
                            android:layout_marginTop="3dp"
                            android:layout_marginRight="5dp"
                            android:layout_weight=".8"
                            android:padding="5dp"
                            android:text="@string/meyyet5"
                            android:textColor="#000000"
                            android:textSize="18sp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight=".2"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/imgmeyyet2"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                app:srcCompat="@drawable/play_button"/>
                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txt_meyyet6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:textColor="#FF141919"
                        android:textSize="18sp"
                        android:text="@string/meyyet6"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txt_meyyet7"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="3dp"
                            android:layout_marginTop="3dp"
                            android:layout_marginRight="5dp"
                            android:layout_weight=".8"
                            android:padding="5dp"
                            android:text="@string/meyyet7"
                            android:textColor="#000000"
                            android:textSize="18sp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight=".2"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/imgmeyyet3"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                app:srcCompat="@drawable/play_button"/>
                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txt_meyyet8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:textColor="#FF141919"
                        android:textSize="18sp"
                        android:text="@string/meyyet8"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txt_meyyet9"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="3dp"
                            android:layout_marginTop="3dp"
                            android:layout_marginRight="5dp"
                            android:layout_weight=".8"
                            android:padding="5dp"
                            android:text="@string/meyyet9"
                            android:textColor="#000000"
                            android:textSize="18sp"
                            />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight=".2"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/imgmeyyet4"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                app:srcCompat="@drawable/play_button"/>
                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txt_meyyet10"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:textColor="#FF141919"
                        android:textSize="18sp"
                        android:text="@string/meyyet10"/>


                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppBarOverlay"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fab_margin"
        app:maxImageSize="56dip"
        app:srcCompat="@drawable/share"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
