<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.androidhive.myapplication">

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:allowBackup="true"
        android:icon="@drawable/untitled"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <activity android:name=".source_activities.VuzuActivity" />
        <activity android:name=".source_activities.GhoslActivity" />
        <activity android:name=".source_activities.TasbihatActivity" />
        <activity android:name=".source_activities.HowToPrayActivity" />
        <activity android:name=".source_activities.MeyetActivity" />
        <activity android:name=".source_activities.SejdeyyesahvActivity" />
        <activity android:name=".TextActivity" />
        <activity android:name=".PrayerActivity" />
        <activity android:name=".source_activities.TayammomActivity" />
        <activity android:name=".source_activities.SourceActivity" />
        <activity android:name=".PrayerTimesActivity"/>
        <activity
            android:name=".compass.CompassActivity"
            android:label="@string/app_name"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:label="@string/title_activity_main2"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden" />
        <activity android:name=".source_activities.AboutActivity" />

        <service
            android:name=".AdhanService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>

</manifest>